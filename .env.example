# knowledge SDK — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# The CLI does not read .env automatically. Source it into your shell,
# use direnv, or load it with python-dotenv before running `knowledge`.

# LLM Provider Configuration
# ---------------------------
# litellm uses the model string to route to the correct provider.
# Set provider-specific API keys as environment variables:
#
#   OpenAI:    OPENAI_API_KEY
#   Anthropic: ANTHROPIC_API_KEY
#   Google:    GEMINI_API_KEY
#   NVIDIA:    NVIDIA_NIM_API_KEY
#   Ollama:    (no key needed — runs locally)
#   vLLM:      (custom endpoint via OPENAI_API_BASE)
#
# Example:
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...
#   GEMINI_API_KEY=AIza...

# HTTP Client Settings
# --------------------
# NOTE: These constants are baked into the SDK at build time today.
# Runtime overrides are planned for v0.2 — see configuration.md.
#
# Maximum response body size in bytes (default: 52428800 = 50 MiB)
# KNOWLEDGE_MAX_BODY_SIZE=52428800
#
# Request timeout in seconds (default: 30)
# KNOWLEDGE_REQUEST_TIMEOUT=30
#
# Maximum retries for transient failures (default: 3)
# KNOWLEDGE_MAX_RETRIES=3
