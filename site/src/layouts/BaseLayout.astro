---
import "@/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = "knowledge — LLM-powered OKF bundle creation",
  description = "An alpha Python SDK that extracts heading-level concepts from URLs and local HTML or Markdown files into linked Markdown bundles.",
  ogImage = "/og-image.png",
} = Astro.props;

const siteName = "knowledge";
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
const baseURL = Astro.site ?? new URL("https://sachncs.github.io");
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const faviconURL = `${basePath}/favicon.svg?v=2`;
const routePath = Astro.url.pathname === basePath || Astro.url.pathname.startsWith(`${basePath}/`)
  ? Astro.url.pathname
  : `${basePath}${Astro.url.pathname}`;
const canonicalPath = routePath.endsWith("/") ? routePath : `${routePath}/`;
const canonicalURL = new URL(canonicalPath, baseURL).toString();
const ogURL = new URL(`${basePath}${ogImage}`, baseURL).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#151a1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="apple-touch-icon" href={`${basePath}/apple-touch-icon.svg`} />
    <link rel="mask-icon" href={faviconURL} color="#2D4966" />

    <!-- RSS / Sitemap -->
    <link rel="sitemap" href={`${basePath}/sitemap-index.xml`} />

    <!-- JSON-LD: SoftwareApplication -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "knowledge",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Linux, macOS, Windows",
        description,
        url: canonicalURL,
        softwareVersion: "0.1.0",
        license: "https://opensource.org/licenses/MIT",
        author: {
          "@type": "Person",
          name: "Sachin",
        },
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
      })}
    />

    <script is:inline>
      // Apply theme before paint to prevent flash
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>

<body>
    <a
      href="#main"
      class="skip-link"
    >
      Skip to content
    </a>

    <slot />

  </body>
</html>
