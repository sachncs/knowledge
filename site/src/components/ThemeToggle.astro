<button class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false" title="Toggle color theme">
  <span aria-hidden="true">◐</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const root = document.documentElement;

  const syncThemeButton = () => {
    button?.setAttribute("aria-pressed", String(root.classList.contains("dark")));
  };

  button?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
    syncThemeButton();
  });

  syncThemeButton();
</script>

<style>
  .theme-toggle { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--line); border-radius: 5px; background: var(--paper-raised); color: var(--muted); cursor: pointer; font-size: 17px; }
  .theme-toggle:hover { color: var(--ink); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
