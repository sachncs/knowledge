---
import Logo from "./Logo.astro";
import ThemeToggle from "./react/ThemeToggle.tsx";
import MobileMenu from "./react/MobileMenu.tsx";

const links = [
  { href: "#features", label: "Features" },
  { href: "#workflow", label: "How it works" },
  { href: "#code", label: "Code" },
  { href: "#use-cases", label: "Use cases" },
  { href: "#faq", label: "FAQ" },
];
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-40 transition-all duration-500 ease-smooth"
>
  <div class="glass">
    <div class="container-wide flex h-[64px] items-center justify-between gap-6">
      <Logo size={28} />

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-nav-link
              class="relative rounded-full px-3.5 py-2 text-sm font-medium text-ink-500 transition-colors duration-200 hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-50 data-[active=true]:text-ink-900 dark:data-[active=true]:text-ink-50"
            >
              <span class="relative z-10">{link.label}</span>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -z-0 rounded-full bg-[var(--bg-soft)] opacity-0 transition-opacity duration-300 data-[active=true]:opacity-100"
              >
              </span>
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2.5">
        <a
          href="https://github.com/sachncs/knowledge"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-ink-600 transition-colors duration-200 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-50 md:inline-flex"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.03c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.5 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.05.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
          </svg>
          <span>Star</span>
        </a>
        <a
          href="https://github.com/sachncs/knowledge#installation"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary hidden md:inline-flex"
        >
          <span>Get started</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
        <ThemeToggle client:load />
        <MobileMenu client:load links={links} />
      </div>
    </div>
  </div>
</header>

<script>
  // Add background to nav after scroll
  const nav = document.getElementById("nav");
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) {
        nav.classList.add("is-scrolled");
      } else {
        nav.classList.remove("is-scrolled");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  #nav.is-scrolled {
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
</style>