---
export interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}

const { size = 36, withWordmark = true, class: className = "" } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`}>
  <span
    class="relative inline-flex shrink-0 items-center justify-center rounded-[10px] shadow-soft transition-transform duration-500 ease-smooth group-hover:scale-[1.04]"
    style={`width:${size}px;height:${size}px;`}
    aria-hidden="true"
  >
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="lg-a" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#7C8BFF" />
          <stop offset="100%" stop-color="#3D4FE0" />
        </linearGradient>
        <linearGradient id="lg-b" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#9AA8FF" />
          <stop offset="100%" stop-color="#5B6BF2" />
        </linearGradient>
        <linearGradient id="lg-c" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#B5C0FF" />
          <stop offset="100%" stop-color="#7C8BFF" />
        </linearGradient>
        <linearGradient id="lg-bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#11151E" />
          <stop offset="100%" stop-color="#0A0D14" />
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="40" height="40" rx="10" fill="url(#lg-bg)" />
      <g stroke="#5B6BF2" stroke-width="1.4" stroke-linecap="round" opacity="0.7">
        <line x1="20" y1="14" x2="12" y2="26" />
        <line x1="20" y1="14" x2="28" y2="26" />
        <line x1="20" y1="14" x2="20" y2="28" />
      </g>
      <circle cx="12" cy="26" r="3.4" fill="url(#lg-c)" />
      <circle cx="20" cy="14" r="4.6" fill="url(#lg-a)" />
      <circle cx="20" cy="28" r="2.8" fill="url(#lg-b)" />
      <circle cx="28" cy="26" r="3.4" fill="url(#lg-c)" />
    </svg>
  </span>
  {
    withWordmark && (
      <span class="text-[17px] font-semibold tracking-tight text-ink-900 dark:text-ink-50">
        knowledge
      </span>
    )
  }
</a>