---
const features = [
  {
    icon: "brain",
    title: "LLM-powered extraction",
    body: "Route any provider litellm supports — OpenAI, Anthropic, Gemini, Bedrock, Azure, vLLM, Ollama — through a single interface. Swap models with one flag.",
    accent: "from-accent-400 to-accent-700",
  },
  {
    icon: "tree",
    title: "OKF v0.1 bundles",
    body: "Output is a real directory: index.md, per-concept Markdown, YAML frontmatter, tag subfolders. Diff, link, search — like documentation should.",
    accent: "from-mint-400 to-mint-600",
  },
  {
    icon: "split",
    title: "Section-aware splitting",
    body: "Native handling of HTML (<h2>–<h4>) and Markdown (##) headings. One concept per section, ordered and resolvable.",
    accent: "from-accent-400 to-mint-500",
  },
  {
    icon: "shield",
    title: "Resilient by default",
    body: "Exponential backoff retries, 50 MiB body cap, charset detection, HTTP error classification — production hygiene built in.",
    accent: "from-accent-300 to-accent-600",
  },
  {
    icon: "terminal",
    title: "CLI + Python API",
    body: "Use the `knowledge` CLI for ad-hoc work, or import the SDK directly. Immutable Pydantic models, predictable behaviour.",
    accent: "from-mint-400 to-accent-500",
  },
  {
    icon: "graph",
    title: "Validated output",
    body: "Structural checks for link resolution and orphan detection. Curate bundles by removing concepts without rewriting the whole graph.",
    accent: "from-accent-500 to-accent-800",
  },
];

const iconPaths: Record<string, string> = {
  brain: "M9.5 2A2.5 2.5 0 0 0 7 4.5v.36a3 3 0 0 0-1.5 5.32V11a2 2 0 0 0 2 2v.5a2.5 2.5 0 0 0 5 0V13a2 2 0 0 0 2-2V9.18A3 3 0 0 0 13 4.86V4.5A2.5 2.5 0 0 0 10.5 2h-1ZM4.5 9a1.5 1.5 0 0 1 1.5-1.5h.5V9a2 2 0 0 0 .5 1.32V11a1 1 0 0 1-1 1H5v-2.5A1.5 1.5 0 0 1 4.5 9Z",
  tree: "M12 3 4 7v10l8 4 8-4V7l-8-4Zm0 2.2 6 3v.6l-6 3-6-3v-.6l6-3Zm-6 5.4 6 3 6-3v6.6l-6 3-6-3V10.6Z",
  split: "M6 3v6a3 3 0 0 0 3 3h6a3 3 0 0 1 3 3v6M3 6h6M3 6l3-3M3 6l3 3M21 18h-6M21 18l-3-3M21 18l-3 3",
  shield: "M12 2 4 5v6c0 5 3.5 9.4 8 11 4.5-1.6 8-6 8-11V5l-8-3Zm-1.5 14L7 12.5l1.4-1.4 2.1 2.1 5.1-5.1L17 9.5 10.5 16Z",
  terminal: "M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm2 4 4 3-4 3M12 14h4",
  graph: "M5 8a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm10 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM14 5a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm-2 5 4 4",
};
---

<section id="features" class="section">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow mx-auto">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        What's inside
      </span>
      <h2 class="reveal mt-5 text-balance text-display-lg gradient-text-muted">
        Engineered for the long tail of
        <span class="gradient-text">documentation work.</span>
      </h2>
      <p
        class="reveal mx-auto mt-5 max-w-xl text-pretty text-lg text-ink-500 dark:text-ink-300"
      >
        Six composable capabilities. No vendor lock-in. No magic. Just a small,
        sharp tool that does one thing well.
      </p>
    </div>

    <div class="stagger mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        features.map((f) => (
          <article class="card card-hover shine group relative overflow-hidden p-6 lg:p-7">
            <div
              aria-hidden="true"
              class={`absolute -right-12 -top-12 h-32 w-32 rounded-full bg-gradient-to-br ${f.accent} opacity-[0.08] blur-2xl transition-opacity duration-500 group-hover:opacity-20`}
            />

            <div class="relative">
              <div
                class={`inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br ${f.accent} text-white shadow-soft`}
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={iconPaths[f.icon]} />
                </svg>
              </div>

              <h3 class="mt-5 text-[17px] font-semibold tracking-tight text-ink-900 dark:text-ink-50">
                {f.title}
              </h3>
              <p class="mt-2 text-[14.5px] leading-relaxed text-ink-500 dark:text-ink-300">
                {f.body}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>