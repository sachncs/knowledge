---
import WorkflowVisual from "./react/WorkflowVisual.tsx";

const steps = [
  {
    n: "01",
    title: "Point at any source",
    body: "Pass a URL or a local HTML/Markdown file. Resilient HTTP client handles redirects, retries, and size limits.",
    chips: ["URL", "HTML", "Markdown", "50 MiB cap"],
  },
  {
    n: "02",
    title: "Split by heading",
    body: "Each <h2>–<h4> (or ##) section becomes a unit. One concept per section — never more, never less.",
    chips: ["HTML headings", "MD headings", "Ordered"],
  },
  {
    n: "03",
    title: "Extract via LLM",
    body: "litellm routes the call to any provider. Each section becomes a structured Pydantic Concept.",
    chips: ["OpenAI", "Anthropic", "Ollama", "Bedrock"],
  },
  {
    n: "04",
    title: "Write OKF bundle",
    body: "A real directory on disk: index.md, per-concept files, YAML frontmatter, tag subfolders. Validated, diffable, ready.",
    chips: ["index.md", "Concept.md", "Tags/", "Validated"],
  },
];
---

<section id="workflow" class="section">
  <div class="container-wide">
    <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-[1fr_auto] lg:gap-16">
      <div class="max-w-2xl">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          How it works
        </span>
        <h2 class="reveal mt-5 text-balance text-display-lg gradient-text-muted">
          From a URL to a structured
          <span class="gradient-text">knowledge graph</span> in four steps.
        </h2>
      </div>
      <p class="reveal max-w-md text-pretty text-base leading-relaxed text-ink-500 dark:text-ink-300 lg:text-right">
        No schema to maintain. No infra to deploy. The output is plain files
        you can read, version, and serve — exactly what good docs should be.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
      <!-- Left: step list -->
      <ol class="stagger relative space-y-5">
        <span
          aria-hidden="true"
          class="absolute left-[18px] top-2 bottom-2 w-px bg-gradient-to-b from-transparent via-[var(--border-strong)] to-transparent"
        ></span>

        {
          steps.map((s) => (
            <li class="relative flex gap-5 rounded-2xl border border-transparent p-3 transition-colors duration-300 hover:border-[var(--border)] hover:bg-[var(--bg-soft)]">
              <span class="relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--bg-elev)] font-mono text-[12px] font-semibold text-ink-700 dark:text-ink-200">
                {s.n}
              </span>
              <div class="flex-1">
                <h3 class="text-[15.5px] font-semibold tracking-tight text-ink-900 dark:text-ink-50">
                  {s.title}
                </h3>
                <p class="mt-1 text-[14px] leading-relaxed text-ink-500 dark:text-ink-300">
                  {s.body}
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {s.chips.map((c) => (
                    <span class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-2 py-0.5 font-mono text-[11px] text-ink-500 dark:text-ink-400">
                      {c}
                    </span>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Right: animated concept graph -->
      <div class="reveal relative lg:pl-2">
        <div
          class="absolute -inset-4 -z-10 rounded-[28px] bg-gradient-to-br from-accent-500/10 via-transparent to-mint-500/10 blur-xl"
          aria-hidden="true"
        ></div>
        <div class="surface-elev overflow-hidden rounded-2xl">
          <div class="flex items-center justify-between border-b border-[var(--border)] px-4 py-2.5">
            <div class="flex items-center gap-2 font-mono text-[12px] text-ink-500 dark:text-ink-400">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="2.5" />
                <circle cx="18" cy="6" r="2.5" />
                <circle cx="6" cy="18" r="2.5" />
                <circle cx="18" cy="18" r="2.5" />
                <path d="M8.5 6h7M6 8.5v7M18 8.5v7M8.5 18h7" />
              </svg>
              knowledge graph · live
            </div>
            <span class="rounded-md bg-mint-500/15 px-1.5 py-0.5 font-mono text-[10px] text-mint-600 dark:text-mint-400">
              OKF v0.1
            </span>
          </div>
          <div class="bg-[var(--bg-deep)] p-2">
            <WorkflowVisual client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>