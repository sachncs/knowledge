---
const useCases = [
  {
    title: "Documentation → RAG corpora",
    body: "Convert any docs site into a clean, linked corpus you can drop into a vector store — without scraping artefacts.",
    tag: "RAG",
    icon: "M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7Zm4 0h10M7 11h6M7 15h4",
  },
  {
    title: "Style guides & references",
    body: "Pull an HTML reference into per-section concept files. Diff them in pull requests. Review like real docs.",
    tag: "Docs",
    icon: "M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14l-4-3-4 3-4-3-4 3V5Z",
  },
  {
    title: "Blog → knowledge base",
    body: "Turn a long-form blog or knowledge dump into a navigable, searchable bundle. One concept per heading.",
    tag: "Content",
    icon: "M3 5h18M3 12h18M3 19h12",
  },
  {
    title: "API doc synthesis",
    body: "Ingest public API references and get back a normalized OKF bundle — ready for a static-site generator.",
    tag: "API",
    icon: "M8 9l-4 3 4 3M16 9l4 3-4 3M14 5l-4 14",
  },
  {
    title: "Internal handbook archival",
    body: "Convert handbook pages into concept files so they're diffable, reviewable, and auditable over time.",
    tag: "Enterprise",
    icon: "M3 7v13h18V7M3 7l3-4h12l3 4M9 12h6",
  },
  {
    title: "Research paper summarization",
    body: "Extract structured concept summaries from long papers or reports. Each section becomes its own file.",
    tag: "Research",
    icon: "M9 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 5h0M12 11h0M12 15h0",
  },
];
---

<section id="use-cases" class="section">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow mx-auto">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Use cases
      </span>
      <h2 class="reveal mt-5 text-balance text-display-lg gradient-text-muted">
        One tool.
        <span class="gradient-text">Many surfaces.</span>
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-pretty text-lg text-ink-500 dark:text-ink-300">
        Anywhere documentation lives, knowledge makes it structured.
      </p>
    </div>

    <div class="stagger mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        useCases.map((u) => (
          <article class="card card-hover shine group relative flex flex-col overflow-hidden p-6">
            <div class="flex items-start justify-between gap-4">
              <span
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-soft)] text-ink-700 transition-colors group-hover:border-accent-500/40 group-hover:text-accent-500 dark:text-ink-200"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={u.icon} />
                </svg>
              </span>
              <span class="rounded-md border border-[var(--border)] bg-[var(--bg-soft)] px-2 py-0.5 font-mono text-[10.5px] uppercase tracking-wider text-ink-500 dark:text-ink-400">
                {u.tag}
              </span>
            </div>
            <h3 class="mt-5 text-[16px] font-semibold tracking-tight text-ink-900 dark:text-ink-50">
              {u.title}
            </h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-500 dark:text-ink-300">
              {u.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>