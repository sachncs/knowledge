---
import HeroVisual from "./react/HeroVisual.tsx";
import Typewriter from "./react/Typewriter.tsx";
---

<section
  id="hero"
  class="relative isolate overflow-hidden pb-24 pt-32 sm:pt-40 lg:pb-32 lg:pt-44"
>
  <!-- Soft grid + aurora -->
  <div class="aurora" aria-hidden="true"></div>
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[680px] opacity-50 dark:opacity-100"
    aria-hidden="true"
  >
    <div class="grid-bg absolute inset-0"></div>
  </div>

  <div class="container-wide relative">
    <div class="mx-auto max-w-3xl text-center">
      <div class="reveal">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          v0.1 · Open source · MIT
        </span>
      </div>

      <h1
        class="reveal mt-6 text-balance text-display-xl gradient-text-muted"
        style="transition-delay: 80ms;"
      >
        Documentation,
        <br />
        <span class="gradient-text">structured.</span>
      </h1>

      <p
        class="reveal mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-ink-500 dark:text-ink-300 sm:text-xl"
        style="transition-delay: 160ms;"
      >
        <span class="font-medium text-ink-800 dark:text-ink-50">knowledge</span> is a Python SDK that splits any URL or file by
        heading, sends each section to a large language model, and writes an
        <span class="font-medium text-ink-800 dark:text-ink-50">OKF v0.1</span> bundle of linked Markdown —
        versionable, diffable, and ready to serve.
      </p>

      <div
        class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
        style="transition-delay: 240ms;"
      >
        <a href="#install" class="btn-primary group">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Install knowledge</span>
          <span
            class="ml-1 inline-flex h-5 items-center rounded-md border border-white/20 bg-white/10 px-1.5 font-mono text-[11px] text-white/80"
          >
            pip
          </span>
        </a>
        <a
          href="https://github.com/sachncs/knowledge"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.03c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.5 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.05.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          <span>Star on GitHub</span>
          <span class="ml-1 inline-flex items-center gap-1 text-[11px] text-ink-400 dark:text-ink-400">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14.39 8.42 21 9.27l-5 4.87L17.18 21 12 17.77 6.82 21 8 14.14l-5-4.87 6.61-.85L12 2z"/></svg>
            <span id="gh-stars" class="font-mono">—</span>
          </span>
        </a>
      </div>

      <div class="reveal mt-10 flex items-center justify-center gap-2 font-mono text-[13px]" style="transition-delay: 320ms;">
        <span class="text-ink-400 dark:text-ink-500">$</span>
        <span class="text-ink-600 dark:text-ink-300">
          pip install
        </span>
        <Typewriter client:visible text="knowledge" />
        <span class="caret text-ink-600 dark:text-ink-300"></span>
      </div>
    </div>

    <!-- Product visual -->
    <div class="reveal mt-16 sm:mt-20 lg:mt-24" style="transition-delay: 360ms;">
      <HeroVisual client:visible />
    </div>

    <!-- Trust strip -->
    <div class="reveal mt-20 sm:mt-24" style="transition-delay: 440ms;">
      <p class="text-center text-xs font-medium uppercase tracking-[0.2em] text-ink-400 dark:text-ink-500">
        Powered by trusted, proven technology
      </p>
      <div class="mt-8 grid grid-cols-2 items-center gap-x-10 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">Pydantic</span>
        </div>
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">litellm</span>
        </div>
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">OpenAI</span>
        </div>
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">Anthropic</span>
        </div>
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">Gemini</span>
        </div>
        <div class="flex items-center justify-center text-ink-400 transition-colors hover:text-ink-700 dark:text-ink-500 dark:hover:text-ink-200">
          <span class="text-base font-semibold tracking-tight">Ollama</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Tiny enhancement: fetch GitHub stars (best-effort, cached for a day)
  (async () => {
    try {
      const cached = sessionStorage.getItem("gh_stars");
      const el = document.getElementById("gh-stars");
      if (!el) return;
      if (cached) {
        el.textContent = cached;
        return;
      }
      const res = await fetch("https://api.github.com/repos/sachncs/knowledge");
      if (!res.ok) throw new Error("gh");
      const data = await res.json();
      const stars = data.stargazers_count;
      if (typeof stars === "number") {
        el.textContent = stars >= 1000 ? `${(stars / 1000).toFixed(1)}k` : String(stars);
        sessionStorage.setItem("gh_stars", el.textContent);
      } else {
        el.textContent = "★";
      }
    } catch {
      const el = document.getElementById("gh-stars");
      if (el) el.textContent = "★";
    }
  })();
</script>