---
---

<section class="section">
  <div class="container-wide">
    <div class="reveal relative overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-elev)] p-10 text-center sm:p-16 lg:p-20">
      <!-- Aurora background -->
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10"
        style="background:
          radial-gradient(60% 60% at 50% 0%, rgba(91,107,242,0.18) 0%, transparent 60%),
          radial-gradient(40% 60% at 80% 100%, rgba(94,234,212,0.14) 0%, transparent 60%);"
      ></div>
      <!-- Subtle grid -->
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-50"
      >
        <div class="grid-bg absolute inset-0"></div>
      </div>

      <span class="eyebrow mx-auto">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        Get started in seconds
      </span>
      <h2 class="reveal mx-auto mt-5 max-w-3xl text-balance text-display-lg gradient-text-muted">
        Turn documentation into
        <span class="gradient-text">infrastructure.</span>
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-pretty text-lg text-ink-500 dark:text-ink-300">
        One pip install. One CLI command. A directory of structured concepts —
        version-controlled, diffable, and ready to serve.
      </p>

      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          type="button"
          data-copy="pip install knowledge"
          class="copy-btn btn-primary group"
        >
          <span class="copy-default inline-flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            <span>pip install knowledge</span>
          </span>
          <span class="copy-done hidden items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>Copied!</span>
          </span>
        </button>
        <a
          href="https://github.com/sachncs/knowledge"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.03c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.5 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.05.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          View on GitHub
        </a>
      </div>

      <p class="reveal mt-6 font-mono text-xs text-ink-400">
        MIT licensed · Python 3.12+ · Zero config
      </p>
    </div>
  </div>
</section>