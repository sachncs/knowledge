---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

interface Link {
  href: string;
  label: string;
  external?: boolean;
}

const groups: { title: string; links: Link[] }[] = [
  {
    title: "Product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#workflow", label: "How it works" },
      { href: "#use-cases", label: "Use cases" },
      { href: "#faq", label: "FAQ" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "https://github.com/sachncs/knowledge", label: "Source code", external: true },
      { href: "https://github.com/sachncs/knowledge/tree/master/docs", label: "Documentation", external: true },
      { href: "https://github.com/sachncs/knowledge/blob/master/CHANGELOG.md", label: "Changelog", external: true },
      { href: "https://github.com/sachncs/knowledge/blob/master/ROADMAP.md", label: "Roadmap", external: true },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/sachncs/knowledge/blob/master/LICENSE", label: "MIT License", external: true },
      { href: "https://github.com/sachncs/knowledge/blob/master/CONTRIBUTING.md", label: "Contributing", external: true },
      { href: "https://github.com/sachncs/knowledge/blob/main/SECURITY.md", label: "Security", external: true },
      { href: "https://github.com/sachncs/knowledge/issues", label: "Issues", external: true },
    ],
  },
];

const social = [
  {
    name: "GitHub",
    href: "https://github.com/sachncs/knowledge",
    icon: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.03c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.21-1.5 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.05.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z",
  },
  {
    name: "PyPI",
    href: "https://pypi.org/project/knowledge/",
    icon: "M12 2 2 7v10l10 5 10-5V7L12 2Zm0 2.5L19.5 8 12 11.5 4.5 8 12 4.5ZM4 9.5l7 3.5v6.5l-7-3.5v-6.5Zm9 10v-6.5l7-3.5v6.5l-7 3.5Z",
  },
];
---

<footer class="relative border-t border-[var(--border)] bg-[var(--bg-soft)]">
  <div class="container-wide py-16 lg:py-20">
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div class="col-span-2 lg:col-span-1">
        <Logo size={28} />
        <p class="mt-5 max-w-xs text-[13.5px] leading-relaxed text-ink-500 dark:text-ink-300">
          An open-source Python SDK for LLM-powered OKF bundle creation from any
          documentation source.
        </p>

        <div class="mt-6 flex items-center gap-2">
          {
            social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--bg-elev)] text-ink-500 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-500/40 hover:text-accent-500 dark:text-ink-400"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d={s.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      {
        groups.map((g) => (
          <div>
            <div class="text-[11px] font-medium uppercase tracking-[0.16em] text-ink-400">
              {g.title}
            </div>
            <ul class="mt-4 space-y-2.5">
              {g.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.external ? "_blank" : undefined}
                    rel={l.external ? "noopener noreferrer" : undefined}
                    class="text-[13.5px] text-ink-600 transition-colors hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-50"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="divider mt-14"></div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 text-[12.5px] text-ink-500 dark:text-ink-400 sm:flex-row sm:items-center">
      <p>
        © {year} Sachin. Released under the <a class="underline-offset-4 hover:underline" href="https://github.com/sachncs/knowledge/blob/master/LICENSE">MIT License</a>.
      </p>
      <p class="flex items-center gap-2 font-mono text-[11.5px]">
        <span class="inline-flex h-1.5 w-1.5 rounded-full bg-mint-500 animate-pulse-soft"></span>
        v0.1.0 · all systems operational
      </p>
    </div>
  </div>
</footer>